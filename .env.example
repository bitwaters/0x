# Market data (required)
GMGN_API_KEY=replace_me
COINGECKO_PRO_API_KEY=replace_me

# Runtime
NODE_ENV=development
DATABASE_PATH=./data/meme-signal.db
SOL_ENABLED=true
BSC_ENABLED=true

# Telegram remains disabled until all values are configured.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_RADAR_CHAT_ID=
TELEGRAM_VALIDATION_CHAT_ID=
TELEGRAM_FORMAL_CHAT_ID=

# Optional overrides
GMGN_POLL_1M_MS=3000
GMGN_POLL_5M_MS=10000
LIQUIDITY_MIN_USD=10000
MAX_OBSERVED_GAIN_RATIO=0.8
TOP10_MAX_RATIO=0.25
INSIDER_MAX_RATIO=0.2
BUNDLER_MAX_RATIO=0.2
DEV_TEAM_MAX_RATIO=0.2
RUG_MAX_RATIO=0.3
TAX_MAX_RATIO=0.05
GMGN_REST_RPM=120
COINGECKO_REST_RPM=450
