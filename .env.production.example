# Low-cap Meme Signal Bot production configuration
# FIRST INSTALL ONLY: create .env.local from this template.
# If .env.local already exists, DO NOT overwrite it; add only missing fields.
# Replace every <...> value, then run:
#   chmod 600 .env.local
#   npm run config:check

# Required market-data credentials. Do not add any other market API.
GMGN_API_KEY=<your_gmgn_api_key>
COINGECKO_PRO_API_KEY=<your_coingecko_analyst_api_key>

# Runtime: one process and one local SQLite database.
NODE_ENV=production
DATABASE_PATH=./data/meme-signal.db
SOL_ENABLED=true
BSC_ENABLED=true

# Telegram BotFather token and three DISTINCT channel IDs.
# Channel IDs normally look like -1001234567890.
# The bot must be an administrator allowed to post and edit messages.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=<your_botfather_token>
TELEGRAM_RADAR_CHAT_ID=<radar_channel_id>
TELEGRAM_VALIDATION_CHAT_ID=<private_validation_channel_id>
TELEGRAM_FORMAL_CHAT_ID=<formal_signal_channel_id>

# Recommended discovery timing.
GMGN_POLL_1M_MS=3000
GMGN_POLL_5M_MS=10000

# Recommended low-market-cap opportunity range and fixed-pool gates.
MARKET_CAP_MIN_USD=20000
MARKET_CAP_MAX_USD=500000
LIQUIDITY_MIN_USD=10000
POOL_AGE_MAX_SECONDS=21600
QUALIFICATION_WINDOW_SECONDS=120
MAX_OBSERVED_GAIN_RATIO=0.8

# Recommended balanced security policy.
TOP10_MAX_RATIO=0.25
INSIDER_MAX_RATIO=0.2
BUNDLER_MAX_RATIO=0.2
DEV_TEAM_MAX_RATIO=0.2
RUG_MAX_RATIO=0.3
TAX_MAX_RATIO=0.05

# Shared provider budgets. Lower these only if your contracts are stricter.
GMGN_REST_RPM=120
COINGECKO_REST_RPM=450
