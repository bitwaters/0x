{
  "name": "low-cap-meme-signal-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "config:check": "node --import tsx src/config-check.ts",
    "dev": "node --dns-result-order=ipv4first --no-network-family-autoselection --import tsx src/index.ts",
    "lint": "eslint .",
    "smoke:live": "node --import tsx src/smoke.ts",
    "start": "node --dns-result-order=ipv4first --no-network-family-autoselection dist/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "ws": "^8.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
